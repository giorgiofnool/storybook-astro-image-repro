+// The service ensureAstroPassthroughImageService() injects through
+// globalThis.astroAsset, as a module Astro can load from `image.service.entrypoint`.
+export default {
+  propertiesToHash: ["src"],
+  validateOptions(options) {
+    return options;
+  },
+  getURL(options) {
+    const src = options.src;
+    if (src != null && typeof src === "object" && "src" in src && typeof src.src === "string") {
+      return src.src;
+    }
+    return typeof src === "string" ? src : "";
+  },
+  getHTMLAttributes(options) {
+    const {
+      src,
+      width,
+      height,
+      format,
+      quality,
+      densities,
+      widths,
+      formats,
+      layout,
+      priority,
+      fit,
+      position,
+      background,
+      ...attrs
+    } = options;
+    const srcObject = src != null && typeof src === "object" ? src : null;
+    return {
+      ...attrs,
+      width: width ?? srcObject?.width,
+      height: height ?? srcObject?.height,
+      loading: attrs.loading ?? "lazy",
+      decoding: attrs.decoding ?? "async"
+    };
+  },
+  getSrcSet() {
+    return [];
+  }
+};
